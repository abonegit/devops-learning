# Terraform working directory

.terraform/

# Terraform state files

*.tfstate
*.tfstate.*

# Terraform variable files (may contain sensitive values)

*.tfvars
*.tfvars.json

# Terraform crash logs

crash.log
crash.*.log

# Private keys

*.pem
*.key

# Local Terraform override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration

.terraformrc
terraform.rc
